{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "node18",
    "moduleResolution": "node16",
    "noEmit": false,
    "paths": {
      "@/*": ["../src/*"],
      "@tests/*": ["../tests/*"]
    },
    "rootDir": "..",
    "types": ["node", "vscode", "mocha"],
    "outDir": "./out",
    "verbatimModuleSyntax": false
  },
  "include": ["./**/*.ts"]
}
